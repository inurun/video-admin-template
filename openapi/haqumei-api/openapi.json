  "components": {
    "schemas": {
      "AnalyzeItem": {
        "type": "object",
        "description": "Analyze-only G2P result. Validate / Synthesis keep [`G2pItem`].",
        "required": ["text", "kana", "dictionary_words"],
        "properties": {
          "dictionary_words": {
            "type": ["array", "null"],
            "items": {
              "$ref": "#/components/schemas/DictionaryWord"
            },
            "description": "Spoken-word indexes actually taken from a user dictionary.\n\n`[]` means tracking succeeded and no dictionary word was used.\n`null` means tracking was incomplete. The field is required."
          },
          "kana": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "warnings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Warning"
            }
          }
        },
        "additionalProperties": false
      },
      "AnalyzeRequest": {
        "type": "object",
        "required": ["texts"],
        "properties": {
          "schema_version": {
            "type": ["string", "null"],
            "description": "`\"2\"`（省略時）または `\"3\"`。v3 の kana は word ごとに `表記:読み` を持つ。",
            "example": "3"
          },
          "texts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      },
      "AnalyzeResponse": {
        "type": "object",
        "required": ["schema_version", "haqumei_version", "items"],
        "properties": {
          "haqumei_version": {
            "type": "string"
          },
          "items": {
