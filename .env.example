# Local haqumei-api by default. Point at another host (e.g. http://192.168.0.200:8080) to use it instead.
# VoiSona credentials live in haqumei-api's own .env.
HAQUMEI_API_URL=http://127.0.0.1:8080
# Required for automatic/manual LLM G2P.
OPENROUTER_API_KEY=your-openrouter-api-key
# Optional. Defaults to /Applications/voicepeak.app/Contents/MacOS/voicepeak.
# VOICEPEAK_PATH=/Applications/voicepeak.app/Contents/MacOS/voicepeak

# Optional Niconico publish settings.
# Publish uses Claude Agent SDK with claude-sonnet-5-5/low and attaches to headed Chrome on CDP port 9222.
# NICONICO_PUBLISH_HARD_TIMEOUT_MS=1200000
# NICONICO_PUBLISH_INACTIVITY_TIMEOUT_MS=180000
# AGENT_BROWSER_EXECUTABLE_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# NICONICO_PUBLISH_LOG_DIR=.logs/niconico-publish
# NICONICO_PUBLISH_LOG_MAX_FILES=50
