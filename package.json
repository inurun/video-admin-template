{
  "name": "video-admin-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "lefthook install",
    "dev": "vite",
    "build": "vite build && vite build -c vite.hf.config.ts && vite build --mode server",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "fallow": "fallow",
    "migrate:project": "tsx scripts/migrate-project-json.ts",
    "openapi:fetch": "tsx scripts/fetch-openapi-schemas.ts",
    "openapi:generate": "openapi-typescript --redocly ./redocly.yaml",
    "openapi:sync": "pnpm openapi:fetch && pnpm openapi:generate",
    "openapi:check": "openapi-typescript --redocly ./redocly.yaml --check",
    "tsc": "tsc --noEmit",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
